# Copie ce fichier en .env puis remplis les valeurs. Ne jamais commiter .env.

# ── Copilot intelligent (facultatif) ─────────────────────────────────────────
# Clé API Anthropic. Sans clé, Copilot fonctionne en mode simple.
ANTHROPIC_API_KEY=

# ── Base de données Supabase (facultatif) ────────────────────────────────────
# Supabase › Project Settings › API. Sans ces deux lignes, les comptes et les
# données restent enregistrés dans le navigateur (mode local).
# La clé « anon / publishable » peut être publique : la sécurité est assurée
# par les règles de supabase/schema.sql. N'utilise JAMAIS la clé service_role ici.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Port du serveur de production (npm start)
PORT=3000
